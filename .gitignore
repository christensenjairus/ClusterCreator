# customize. The .example files themselves stay tracked.
terraform/clusters.tf
terraform/networks.tf
ansible/tmp
*.DS_Store
scripts/.env
# Never commit a decrypted secrets file
secrets.sops.dec.yaml
secrets.dec.yaml
