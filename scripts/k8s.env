### -------------------------------------------------------
### --------------General Template Config------------------
### -------------------------------------------------------

NON_PASSWORD_PROTECTED_SSH_KEY="id_rsa" # assumed that this is in ~/.ssh/ and the .pub file is named similarly
PROXMOX_USERNAME=root
PROXMOX_DISK_DATASTORE="rbd"
PROXMOX_BACKUPS_DATASTORE="pbs"
PROXMOX_ISO_PATH="/var/lib/vz/template/iso"
TEMPLATE_VM_BRIDGE=vmbr0
# PROXMOX_HOST is now selected per-environment via SOPS + `ccr env <name>`
# (see secrets.sops.yaml). Do not set it here.
TIMEZONE="America/Denver"
TEMPLATE_VM_GATEWAY="192.168.7.1"
TEMPLATE_VM_IP="192.168.7.100/24"
TEMPLATE_VM_SEARCH_DOMAIN="us-west-1.hahomelabs.com"
# TIMEZONE="America/Chicago"
# TEMPLATE_VM_GATEWAY="192.168.6.1"
# TEMPLATE_VM_IP="192.168.6.100/24"
# TEMPLATE_VM_SEARCH_DOMAIN="us-central-1.hahomelabs.com"
TEMPLATE_VLAN_TAG="0" # None if no vlan, otherwise the vlan tag (e.g. 100)
TWO_DNS_SERVERS="1.1.1.1 1.0.0.1"
TEMPLATE_VM_CPU_TYPE="x86-64-v3"
TEMPLATE_VM_CPU=8
TEMPLATE_VM_MEM=8192

### -------------------------------------------------------
### ------------------Kernel Pinning-----------------------
### -------------------------------------------------------

# Pin to a known-good kernel to work around broken Ubuntu 6.8.0-*
# releases that randomly drop UDP packets, which sends Cilium into
# CrashLoopBackOff and takes networking down for other pods on the node.
# See: https://bugs.launchpad.net/ubuntu/+source/linux/+bug/2141531
#
# If the newest installed kernel shares the same major.minor.patch
# (e.g. 6.8.0) as the pinned version, the system will boot the
# pinned kernel instead. A jump to a new series (e.g. 6.8.1, 6.12)
# is allowed automatically. Set to "none" to disable pinning.
#
# Note that Ubuntu 24.04's GA kernel stays on 6.8.0 for the life of the
# release (only the ABI suffix moves, e.g. -106 -> -136); new series only
# arrive via the HWE metapackages, which this project does not install.
# So on 24.04 the series check never lapses on its own — clearing the pin
# is a manual edit here. Changing this to "none" resets GRUB on the next
# `ccr upgrade-node` run.
# PINNED_KERNEL_VERSION=6.8.0-106-generic

### -------------------------------------------------------
### --------------PKGS to Install with APT-----------------
### ---kubectl, kubeadm, and kubelet use the k8s version---
### -----`apt-cache madison <package>` to find versions----
### -------------------------------------------------------

KUBERNETES_SHORT_VERSION=1.36
KUBERNETES_MEDIUM_VERSION=1.36.3
KUBERNETES_LONG_VERSION=1.36.3-1.1

# ------------------- Addon Versions ----------------------

CILIUM_VERSION=1.19.6
KUBELET_SERVING_CERT_APPROVER_VERSION=0.11.0
LOCAL_PATH_PROVISIONER_VERSION=0.0.36
METRICS_SERVER_VERSION=3.13.1
METALLB_VERSION=0.15.3

# ----------------NVIDIA Drivers (optional)----------------
# Versions on Debian:
#   Bookworm only has 535.
# To find versions on Ubuntu:
#   apt search nvidia-driver | grep -E '^nvidia-driver-[0-9]+-server' | cut -d '/' -f 1
# Adds substantial creation time & disk utilization for the template vm.
# To install, set NVIDIA_DRIVER_ENABLED to true and increase TEMPLATE_DISK_SIZE below.

NVIDIA_DRIVER_ENABLED=false
NVIDIA_DRIVER_VERSION=595 # only used on Ubuntu

# The template vm's cpu/mem resources only matter for initial creation.
# More cpu greatly speeds up nvidia driver installation.

### -------------------------------------------------------
### --------------PKGS to Download Directly----------------
### -----Find these directly on GitHub Release Pages-------
### -------------------------------------------------------

CNI_PLUGINS_VERSION=1.9.1
ETCD_VERSION=3.7.1

# ETCD_VERSION only applies with decoupled etcd clusters.

### -------------------------------------------------------
### -------------Template Image selection------------------
### This project only supports debian & ubuntu based images
### Some pkg versions may be different for different images
### -------------------------------------------------------

# As a speed optimization, the disk size could be set to be just large enough to fit
#   the image and the k8s pkgs to help with vm cloning speed. The k8s installation
#   ansible will check to make sure there wasn't any disk space issues during the
#   template creation process.

# Some storage backends need the disk size to be an integer (e.g. '4', not '4.6')
#   See this issue: https://github.com/christensenjairus/ClusterCreator/issues/47

# Using a more recent Ubuntu version is recommended if you use Intel GPUs, as it 
# has a more recent kernel, which is needed for some Intel ARC cards.

### Debian 12 Image (Bookworm)
#TEMPLATE_VM_ID=9000
#TEMPLATE_VM_NAME="k8s-ready-template"
#IMAGE_NAME="debian-12-generic-amd64.qcow2"
#IMAGE_LINK="https://cloud.debian.org/images/cloud/bookworm/latest/${IMAGE_NAME}"
#EXTRA_TEMPLATE_TAGS="bookworm template"
#TEMPLATE_DISK_SIZE=10G

### Ubuntu 24.04 LTS Image (Noble Numbat)
TEMPLATE_VM_ID=9001
TEMPLATE_VM_NAME="k8s-ready-template"
IMAGE_NAME="ubuntu-24.04-server-cloudimg-amd64.img"
IMAGE_LINK="https://cloud-images.ubuntu.com/releases/24.04/release/${IMAGE_NAME}"
EXTRA_TEMPLATE_TAGS="24.04-lts template"
TEMPLATE_DISK_SIZE=10G

### Ubuntu 25.04 Image (Plucky Puffin)
#TEMPLATE_VM_ID=9002
#TEMPLATE_VM_NAME="k8s-ready-template"
#IMAGE_NAME="ubuntu-25.04-server-cloudimg-amd64.img"
#IMAGE_LINK="https://cloud-images.ubuntu.com/releases/plucky/release/${IMAGE_NAME}"
#EXTRA_TEMPLATE_TAGS="25.04 template"
#TEMPLATE_DISK_SIZE=10G

